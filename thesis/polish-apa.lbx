% Daty po polsku: „24 marca 2020”, „18–20 września 2019” (dzień, miesiąc w dopełniaczu, rok),
% a w dacie z adresu URL bez przecinka przed „z:” — „Pobrane 24 marca 2020 z: https://…”.
\DeclareBibliographyExtras{%
  \def\urldatecomma{\addspace}%
  \protected\def\pollubapa@data#1#2#3#4#5{%
    \ifboolexpr{ (test {\ifentrytype{article}}
                  or (test {\ifentrytype{inbook}} and not test {\ifnameundef{editor}}))
                 and not test {\iffieldequalstr{entrysubtype}{nonacademic}} }
      {\clearfield{labelmonth}%
       \clearfield{labelday}}
      {}%
    \iffieldundef{#4}% DAY
      {}%
      {\stripzeros{\thefield{#4}}%
       \iffieldundef{#3}{}{\nobreakspace}}%
    \iffieldundef{#3}% MONTH
      {}%
      {\iffieldundef{#4}%
         {\mkbibmonth{\thefield{#3}}}%
         {\lbx@pl@mkbibmonth{\thefield{#3}}}%
       \iffieldundef{#1}{}{\space}}%
    \iffieldundef{#2}% YEARDIVISION
      {}%
      {\iffieldbibstring{#2}{\bibcplstring{\thefield{#2}}}{\thefield{#2}}%
       \iffieldundef{#1}{}{\space}}%
    \iffieldundef{#1}% YEAR
      {}%
      {\iffieldbibstring{#1}{\bibncpstring{\thefield{#1}}}{\thefield{#1}}#5}}%
  \protected\def\mkbibdateapalong#1#2#3#4{\pollubapa@data{#1}{#2}{#3}{#4}{}}%
  \protected\def\mkbibdateapalongextra#1#2#3#4{\pollubapa@data{#1}{#2}{#3}{#4}{\printfield{extradate}}}%
  \protected\def\mkbibdateapalongmdy#1#2#3#4{\pollubapa@data{#1}{#2}{#3}{#4}{}}%
  % Zakresy dat po polsku: „18–20 września 2019”, „30 września – 2 października 2019”,
  % „2019–2020”. Zastępują \mkdaterangeapalong(extra) z apa.bbx, które składają po angielsku.
  % #1 — prefiks daty (label, url, event…), #2 — dopisek po roku (extradate dla daty etykiety).
  \protected\def\pollubapa@zakres#1#2{%
    \begingroup
      \blx@metadateinfo{#1}%
      \iffieldundef{#1year}{}
        {\printtext[#1date]{%
           \datecircaprint
           \iffieldundef{#1endyear}
             {\pollubapa@data{#1year}{#1yeardivision}{#1month}{#1day}{#2}}
             {\iffieldequalstr{#1endyear}{}% zakres otwarty
                {\pollubapa@data{#1year}{#1yeardivision}{#1month}{#1day}{}%
                 \bibdatedash\bibstring{present}}
                {\iffieldsequal{#1year}{#1endyear}
                   {\iffieldsequal{#1month}{#1endmonth}
                      {\iffieldsequal{#1day}{#1endday}
                         {}
                         {\stripzeros{\thefield{#1day}}\bibdatedash}}
                      {\pollubapa@data{}{}{#1month}{#1day}{}\bibdatedash}}
                   {\pollubapa@data{#1year}{#1yeardivision}{#1month}{#1day}{}\bibdatedash}%
                 \pollubapa@data{#1endyear}{#1endyeardivision}{#1endmonth}{#1endday}{#2}}}%
           \dateuncertainprint}}%
    \endgroup}%
  \renewcommand*{\mkdaterangeapalong}[1]{\pollubapa@zakres{#1}{}}%
  \renewcommand*{\mkdaterangeapalongextra}[1]{\pollubapa@zakres{#1}{\printfield{extradate}}}%
}

\endinput
